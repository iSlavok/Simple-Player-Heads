{
	"schemaVersion": 1,
	"id": "simple-player-heads",
	"version": "${version}",
	"name": "Simple Player Heads",
	"description": "Drops a player's head on death, configurable per death cause (self-kill, killed by another player, or any other death).",
	"authors": [
		"iSlavok"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/simple-player-heads",
		"sources": "https://github.com/iSlavok/Simple-Player-Heads",
		"issues": "https://github.com/iSlavok/Simple-Player-Heads/issues"
	},
	"license": "MIT",
	"icon": "assets/simple-player-heads/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "online.slavok.heads.SimplePlayerHeads",
				"adapter": "kotlin"
			}
		],
		"modmenu": [
			{
				"value": "online.slavok.heads.ModMenuIntegration",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"simple-player-heads.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.15.11",
		"minecraft": "${minecraft_dep}",
		"java": ">=${java_level}",
		"fabric-api": "*",
		"fabric-language-kotlin": "*",
		"cloth-config": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
